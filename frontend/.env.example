# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CLARA backend WebSocket (must match backend PORT, default 6969)
VITE_WS_URL=ws://localhost:6969/ws/clara
# Token attached as query param during ws handshake.
# Required only when backend WS auth is enabled (WS_AUTH_REQUIRED=true with WS_AUTH_TOKEN / signing secret).
# Must match backend WS_AUTH_TOKEN OR be a valid short-lived signed token.
VITE_WS_TOKEN=
# Demo default is pinned to browser mode for reliability.
# "browser" = Web Speech API capture in frontend, backend handles LLM/TTS.
# "backend" = backend captures kiosk mic directly (manual hardware verification path).
VITE_VOICE_INPUT_MODE=browser
